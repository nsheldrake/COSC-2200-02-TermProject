<Window x:Class="CrazyEightsCosc2200.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CrazyEightsCosc2200"
        mc:Ignorable="d"
        Title="Crazy 8's"
        Height="700" Width="1000"
        MinHeight="700" MinWidth="1000"
        WindowStartupLocation="CenterScreen">

    <Grid>
        <DockPanel>
        <!-- Top Menu Bar -->
        <DockPanel DockPanel.Dock="Top" Background="#06193B" Height="50">

                <!-- Left Side: Rules and Settings Buttons -->
                <StackPanel Orientation="Horizontal"
                            DockPanel.Dock="Left"
                            VerticalAlignment="Center"
                            Margin="8,0">
                    <Button x:Name="buttonRules"
                            Content="Rules"
                            Height="30"
                            Width="80" Margin="6"
                            Background="#06193B"
                            Foreground="White"
                            BorderBrush="#6666BB"
                            Click="rulesClick"/>
                    <Button x:Name="buttonSettings"
                            Content="Settings"
                            Height="30"
                            Width="80" Margin="0"
                            Background="#06193B"
                            Foreground="White"
                            BorderBrush="#6666BB"
                            Click="settingsClick"/>
                </StackPanel>

                <!-- Right Side: Reset and Exit Buttons -->
                <StackPanel Orientation="Horizontal"
                            DockPanel.Dock="Right"
                            VerticalAlignment="Center"
                            Margin="8,0">
                    <Button x:Name="buttonReset"
                            Content="Reset"
                            Height="30"
                            Width="80" Margin="6"
                            Background="#06193B"
                            Foreground="White"
                            BorderBrush="#6666BB"
                            Click="resetClick"/>
                    <Button x:Name="buttonExit"
                            Content="Exit"
                            Height="30"
                            Width="80" Margin="0"
                            Background="#06193B"
                            Foreground="White"
                            BorderBrush="#6666BB"
                            Click="exitClick"/>
                </StackPanel>

            <!-- Center: Game Title -->
            <TextBlock Text="CRAZY 8'S"
                       FontSize="20"
                       FontWeight="Bold"
                       Foreground="White"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>
        </DockPanel>

        <!-- Bottom: Draw / Play & Hand -->
        <StackPanel DockPanel.Dock="Bottom" Background="#06193B">
            
            <!-- Draw and Play Buttons -->
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        Margin="0,10">
                <Button x:Name="buttonDraw"
                        Content="Draw"
                        Width="100" Height="35"
                        Margin="10,0"
                        Background="#2C4863"
                        Foreground="White"
                        BorderBrush="#517DA8"
                        Click="drawClick"/>
                <Button x:Name="buttonPlay"
                        Content="Play"
                        Width="100" Height="35"
                        Margin="10,0"
                        Background="#1B520C"
                        Foreground="White"
                        BorderBrush="#389C38"
                        Click="playClick"/>
            </StackPanel>
            
            <!-- Bottom: Users Hand -->
            <!-- The card objects in the hand will be displayed here -->
            <TextBlock Text="Your Hand"
                       Foreground="White"
                       FontSize="15"
                       FontWeight="Bold"
                       Margin="15,0,0,5"/>
            <ScrollViewer HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Disabled"
                          CanContentScroll="True"
                          Background="Transparent">
                
                    <!-- Items control for cards and click event binding -->
                    <ItemsControl ItemsSource="{Binding RealPlayerHand}" HorizontalAlignment="Center">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button DataContext="{Binding}" Click="CardClick" Width="100" Height="150" Background="Transparent">
                                    <Image Source="{Binding FaceImage}" Width="100" Height="150" Stretch="Fill"/>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                </ScrollViewer>
        </StackPanel>

        <!-- Middle: Deck / Pile -->
        <Grid Background="#0E2B06">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            
            <!-- Computer Area -->
            <StackPanel Grid.Row="0"
                        HorizontalAlignment="Center"
                        Margin="0,20,0,10">
                <TextBlock Text="Computer Player"
                           Foreground="White"
                           FontSize="16"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,8"/>
                    <ItemsControl ItemsSource="{Binding ComputerHand}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>

                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Image Source="{Binding BackImage}" Width="60"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="{Binding OpponentCardCountText}"
                           Foreground="White"
                           FontSize="14"
                           HorizontalAlignment="Center"
                           Margin="0,8,0,0"/>   
            </StackPanel>

                <!-- Deck -->
                <StackPanel Grid.Row="1"
                    HorizontalAlignment="Left"
                    Margin="250,0,0,0"
                    VerticalAlignment="Center">

                    <TextBlock Text="Deck"
                       Foreground="White"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,5"/>

                    <Image Source="/Images/card_back.png"
                       Width="100"
                       Height="150"/>

                    <TextBlock Text="{Binding DeckCountText}"
                       Foreground="White"
                       HorizontalAlignment="Center"/>
                </StackPanel>

                <!-- Pile -->
                <StackPanel Grid.Row="1"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">

                    <TextBlock Text="Discard Pile"
                       Foreground="White"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,5"/>

                    <Image Source="{Binding Pile.TopCard.FaceImage}"
                       Width="100"
                       Height="150"/>
                </StackPanel>


            </Grid>
            </DockPanel>
            <!-- Dark Background -->
            <Grid x:Name="DarkBackground"
              Background="#CC000000"
              Visibility="Collapsed"
              Panel.ZIndex="1"/>

            <!-- Settings Screen -->
            <StackPanel x:Name="SettingsScreen" Visibility="Collapsed" Margin="20,60,20,20" Panel.ZIndex="2">

                <TextBlock Text="Background Color" FontWeight="Bold" Margin="0,0,0,5" Foreground="White"/>
                <ComboBox x:Name="BackgroundColorPicker" Margin="0,0,0,15">

                    <!-- Red -->
                    <ComboBoxItem Tag="#FF0000">
                        <StackPanel Orientation="Horizontal">
                            <Rectangle Width="20" Height="20" Fill="#FF0000" Margin="0,0,8,0"/>
                            <TextBlock Text="#FF0000 (Red)"/>
                        </StackPanel>
                    </ComboBoxItem>

                    <!-- Orange -->
                    <ComboBoxItem Tag="#FF7F00">
                        <StackPanel Orientation="Horizontal">
                            <Rectangle Width="20" Height="20" Fill="#FF7F00" Margin="0,0,8,0"/>
                            <TextBlock Text="#FF7F00 (Orange)"/>
                        </StackPanel>
                    </ComboBoxItem>

                    <!-- Yellow -->
                    <ComboBoxItem Tag="#FFFF00">
                        <StackPanel Orientation="Horizontal">
                            <Rectangle Width="20" Height="20" Fill="#FFFF00" Margin="0,0,8,0"/>
                            <TextBlock Text="#FFFF00 (Yellow)"/>
                        </StackPanel>
                    </ComboBoxItem>

                    <!-- Green -->
                    <ComboBoxItem Tag="#00FF00">
                        <StackPanel Orientation="Horizontal">
                            <Rectangle Width="20" Height="20" Fill="#00FF00" Margin="0,0,8,0"/>
                            <TextBlock Text="#00FF00 (Green)"/>
                        </StackPanel>
                    </ComboBoxItem>

                    <!-- Blue -->
                    <ComboBoxItem Tag="#0000FF">
                        <StackPanel Orientation="Horizontal">
                            <Rectangle Width="20" Height="20" Fill="#0000FF" Margin="0,0,8,0"/>
                            <TextBlock Text="#0000FF (Blue)"/>
                        </StackPanel>
                    </ComboBoxItem>

                    <!-- Indigo -->
                    <ComboBoxItem Tag="#4B0082">
                        <StackPanel Orientation="Horizontal">
                            <Rectangle Width="20" Height="20" Fill="#4B0082" Margin="0,0,8,0"/>
                            <TextBlock Text="#4B0082 (Indigo)"/>
                        </StackPanel>
                    </ComboBoxItem>

                    <!-- Violet -->
                    <ComboBoxItem Tag="#8F00FF">
                        <StackPanel Orientation="Horizontal">
                            <Rectangle Width="20" Height="20" Fill="#8F00FF" Margin="0,0,8,0"/>
                            <TextBlock Text="#8F00FF (Violet)"/>
                        </StackPanel>
                    </ComboBoxItem>

                </ComboBox>

                <TextBlock Text="Menu Color" FontWeight="Bold" Margin="0,0,0,5" Foreground="White"/>
                <ComboBox x:Name="MenuColorPicker" Margin="0,0,0,15">

                    <!-- Same items reused -->
                    <ComboBoxItem Tag="#FF0000">
                        <StackPanel Orientation="Horizontal">
                            <Rectangle Width="20" Height="20" Fill="#FF0000" Margin="0,0,8,0"/>
                            <TextBlock Text="#FF0000 (Red)"/>
                        </StackPanel>
                    </ComboBoxItem>

                    <ComboBoxItem Tag="#FF7F00">
                        <StackPanel Orientation="Horizontal">
                            <Rectangle Width="20" Height="20" Fill="#FF7F00" Margin="0,0,8,0"/>
                            <TextBlock Text="#FF7F00 (Orange)"/>
                        </StackPanel>
                    </ComboBoxItem>

                    <ComboBoxItem Tag="#FFFF00">
                        <StackPanel Orientation="Horizontal">
                            <Rectangle Width="20" Height="20" Fill="#FFFF00" Margin="0,0,8,0"/>
                            <TextBlock Text="#FFFF00 (Yellow)"/>
                        </StackPanel>
                    </ComboBoxItem>

                    <ComboBoxItem Tag="#00FF00">
                        <StackPanel Orientation="Horizontal">
                            <Rectangle Width="20" Height="20" Fill="#00FF00" Margin="0,0,8,0"/>
                            <TextBlock Text="#00FF00 (Green)"/>
                        </StackPanel>
                    </ComboBoxItem>

                    <ComboBoxItem Tag="#0000FF">
                        <StackPanel Orientation="Horizontal">
                            <Rectangle Width="20" Height="20" Fill="#0000FF" Margin="0,0,8,0"/>
                            <TextBlock Text="#0000FF (Blue)"/>
                        </StackPanel>
                    </ComboBoxItem>

                    <ComboBoxItem Tag="#4B0082">
                        <StackPanel Orientation="Horizontal">
                            <Rectangle Width="20" Height="20" Fill="#4B0082" Margin="0,0,8,0"/>
                            <TextBlock Text="#4B0082 (Indigo)"/>
                        </StackPanel>
                    </ComboBoxItem>

                    <ComboBoxItem Tag="#8F00FF">
                        <StackPanel Orientation="Horizontal">
                            <Rectangle Width="20" Height="20" Fill="#8F00FF" Margin="0,0,8,0"/>
                            <TextBlock Text="#8F00FF (Violet)"/>
                        </StackPanel>
                    </ComboBoxItem>

                </ComboBox>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                        <Button Content="Save"
                            Width="100"
                            HorizontalAlignment="Left"
                            Grid.Column="1"
                            Click="SaveSettingsClick"/>

                        <Button Content="Exit"
                            Width="100"
                            HorizontalAlignment="Right"
                            Grid.Column="2"
                            Click="ExitSettingsClick"/>
                    </Grid>

        </StackPanel>

        <StackPanel x:Name="RulesScreen"
                Visibility="Collapsed"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Panel.ZIndex="2">

            <TextBlock Text="How to Play Crazy Eights"
               FontSize="25"
               FontWeight="Bold"
               Margin="0,0,0,10"
               Foreground="White"/>

            <TextBlock TextWrapping="Wrap" Foreground="White" FontSize="25">
                <LineBreak/>
                1. Each player is dealt 5 cards.<LineBreak/>
                2. The remaining cards form the draw pile.<LineBreak/>
                3. The top card starts the discard pile.<LineBreak/>
                4. Match suit or rank to play a card.<LineBreak/>
                5. Eights are wild, you can choose a suit.<LineBreak/>
                6. If you cannot play, draw a card.<LineBreak/>
                7. First player with no cards wins!
            </TextBlock>

            <Button Content="Close"
                Width="100"
                HorizontalAlignment="Center"
                Margin="0,20,0,0"
                Click="CloseRulesClick"/>
        </StackPanel>

        <!-- Suit Selection Screen -->
        <StackPanel x:Name="SuitScreen"
            Visibility="Collapsed"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Panel.ZIndex="2">

            <TextBlock Text="You played an Eight! Choose a suit:"
               FontSize="20"
               FontWeight="Bold"
               Foreground="White"
               HorizontalAlignment="Center"
               Margin="0,0,0,20"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Content="Hearts"
                Width="100" Height="40" Margin="10"
                Background="#06193B" Foreground="White"
                BorderBrush="#6666BB"
                Click="SuitHearts"/>
                <Button Content="Diamonds"
                Width="100" Height="40" Margin="10"
                Background="#06193B" Foreground="White"
                BorderBrush="#6666BB"
                Click="SuitDiamonds"/>
                <Button Content="Clubs"
                Width="100" Height="40" Margin="10"
                Background="#06193B" Foreground="White"
                BorderBrush="#6666BB"
                Click="SuitClubs"/>
                <Button Content="Spades"
                Width="100" Height="40" Margin="10"
                Background="#06193B" Foreground="White"
                BorderBrush="#6666BB"
                Click="SuitSpades"/>
            </StackPanel>

        </StackPanel>

        <!-- Winner Screen -->
        <StackPanel x:Name="WinnerScreen"
            Visibility="Collapsed"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Panel.ZIndex="2">

            <TextBlock x:Name="WinnerText"
               FontSize="28"
               FontWeight="Bold"
               Foreground="White"
               HorizontalAlignment="Center"
               Margin="0,0,0,10"/>

            <TextBlock x:Name="WinnerSubText"
               FontSize="18"
               Foreground="White"
               HorizontalAlignment="Center"
               Margin="0,0,0,30"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Content="Play Again"
                Width="120" Height="40" Margin="10"
                Background="#06193B" Foreground="White"
                BorderBrush="#6666BB"
                Click="WinnerResetClick"/>
                <Button Content="Exit"
                Width="120" Height="40" Margin="10"
                Background="#06193B" Foreground="White"
                BorderBrush="#6666BB"
                Click="WinnerExitClick"/>
            </StackPanel>

        </StackPanel>

    </Grid>
</Window>
