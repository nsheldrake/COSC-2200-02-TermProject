<Window x:Class="CrazyEightsCosc2200.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CrazyEightsCosc2200"
        mc:Ignorable="d"
        Title="Crazy 8's"
        Height="700" Width="1000"
        MinHeight="700" MinWidth="1000"
        WindowStartupLocation="CenterScreen">

    <!-- HotKeys -->
    <Window.InputBindings>
        <!-- Start Game (Enter) -->
        <KeyBinding Key="Enter" Command="{x:Static ApplicationCommands.New}" />
       
        <!-- Guide -->
        <KeyBinding Key="F1" Command="{x:Static ApplicationCommands.Help}" />

        <!-- Draw -->
        <KeyBinding Key="D" Modifiers="Ctrl" Command="{x:Static ApplicationCommands.Open}" />

        <!-- Play -->
        <KeyBinding Key="P" Modifiers="Ctrl" Command="{x:Static ApplicationCommands.Save}" />

        <!-- Reset -->
        <KeyBinding Key="R" Modifiers="Ctrl" Command="{x:Static ApplicationCommands.New}" />

        <!-- Settings -->
        <KeyBinding Key="S" Modifiers="Ctrl" Command="{x:Static ApplicationCommands.Properties}" />

        <!-- Exit / Back -->
        <KeyBinding Key="Escape" Command="{x:Static ApplicationCommands.Close}" />
    </Window.InputBindings>

    <Window.CommandBindings>

        <!-- Guide -->
        <CommandBinding Command="{x:Static ApplicationCommands.Help}"
                    Executed="GuideCommand_Executed"/>

        <!-- Draw -->
        <CommandBinding Command="{x:Static ApplicationCommands.Open}"
                    Executed="DrawCommand_Executed"/>

        <!-- Play -->
        <CommandBinding Command="{x:Static ApplicationCommands.Save}"
                    Executed="PlayCommand_Executed"/>

        <!-- Reset / Start Game -->
        <CommandBinding Command="{x:Static ApplicationCommands.New}"
                    Executed="ResetCommand_Executed"/>

        <!-- Settings -->
        <CommandBinding Command="{x:Static ApplicationCommands.Properties}"
                    Executed="SettingsCommand_Executed"/>

        <!-- Exit / ESC -->
        <CommandBinding Command="{x:Static ApplicationCommands.Close}"
                    Executed="CloseCommand_Executed"/>

    </Window.CommandBindings>

    <Grid>
        <DockPanel>
        <!-- Top Menu Bar -->
        <DockPanel x:Name="GameTopMenu" DockPanel.Dock="Top" Background="#06193B" Height="50">

                <!-- Left Side: Rules and Settings Buttons -->
                <StackPanel Orientation="Horizontal"
                            DockPanel.Dock="Left"
                            VerticalAlignment="Center"
                            Margin="8,0">
                    <Button x:Name="buttonRules"
                            Content="Guide"
                            Height="30"
                            Width="80" Margin="6"
                            Background="#06193B"
                            Foreground="White"
                            BorderBrush="#6666BB"
                            ToolTip="Open the game guide and rules (F1)"
                            Click="rulesClick"/>
                    <Button x:Name="buttonSettings"
                            Content="Settings"
                            Height="30"
                            Width="80" Margin="0"
                            Background="#06193B"
                            Foreground="White"
                            BorderBrush="#6666BB"
                            ToolTip="Open settings menu (Ctrl + S)"
                            Click="settingsClick"/>
                </StackPanel>

                <!-- Right Side: Reset and Exit Buttons -->
                <StackPanel Orientation="Horizontal"
                            DockPanel.Dock="Right"
                            VerticalAlignment="Center"
                            Margin="8,0">
                    <Button x:Name="buttonReset"
                            Content="Reset"
                            Height="30"
                            Width="80" Margin="6"
                            Background="#06193B"
                            Foreground="White"
                            BorderBrush="#6666BB"
                            ToolTip="Start a new game and reset all cards (Ctrl + R)"
                            Click="resetClick"/>
                    <Button x:Name="buttonExit"
                            Content="Exit"
                            Height="30"
                            Width="80" Margin="0"
                            Background="#06193B"
                            Foreground="White"
                            BorderBrush="#6666BB"
                            ToolTip="End current game and return to main menu (Esc)"
                            Click="GameExitClick"/>
                </StackPanel>

            <!-- Center: Game Title -->
            <TextBlock Text="CRAZY 8'S"
                       FontSize="20"
                       FontWeight="Bold"
                       Foreground="White"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>
        </DockPanel>

        <!-- Bottom: Draw / Play & Hand -->
        <StackPanel x:Name="GameBottomMenu" DockPanel.Dock="Bottom" Background="#06193B">
            
            <!-- Draw and Play Buttons -->
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        Margin="0,10">
                <Button x:Name="buttonDraw"
                        Content="Draw"
                        Width="100" Height="35"
                        Margin="10,0"
                        Background="#2C4863"
                        Foreground="White"
                        BorderBrush="#517DA8"
                        ToolTip="Draw a card from the deck if you have no valid move (Ctrl + D)"
                        Click="drawClick"/>
                <Button x:Name="buttonPlay"
                        Content="Play"
                        Width="100" Height="35"
                        Margin="10,0"
                        Background="#1B520C"
                        Foreground="White"
                        BorderBrush="#389C38"
                        ToolTip="Play the selected card onto the pile (Ctrl + P)"
                        Click="playClick"/>
            </StackPanel>
            
            <!-- Bottom: Users Hand -->
            <!-- The card objects in the hand will be displayed here -->
            <TextBlock Text="Your Hand"
                       Foreground="White"
                       FontSize="15"
                       FontWeight="Bold"
                       Margin="15,0,0,5"/>
            <ScrollViewer HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Disabled"
                          CanContentScroll="True"
                          Background="Transparent">
                
                    <!-- Items control for cards and click event binding -->
                    <ItemsControl ItemsSource="{Binding RealPlayerHand}" HorizontalAlignment="Center">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button DataContext="{Binding}" Click="CardClick" Width="100" Height="150" Background="Transparent">
                                    <Image Source="{Binding FaceImage}" Width="100" Height="150" Stretch="Fill"/>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                </ScrollViewer>
        </StackPanel>

            <!-- Middle: Deck / Pile -->
            <Grid x:Name="GameBackground" Background="#0E2B06">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Row 0: Turn Bar and Status Bar -->
                <Grid Grid.Row="0" Margin="10,8,10,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="200"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="200"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                           Text="Current Turn:"
                           Foreground="White"
                           FontSize="13"
                           FontWeight="Bold"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0"/>
                    <Border Grid.Column="1"
                        Background="#0A1F04"
                        BorderBrush="#2E5E1E"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="8,4">
                        <TextBlock Text="{Binding TurnText}"
                               Foreground="White"
                               FontSize="13"
                               VerticalAlignment="Center"/>
                    </Border>

                    <TextBlock Grid.Column="3"
                           Text="Status:"
                           Foreground="White"
                           FontSize="13"
                           FontWeight="Bold"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0"/>
                    <Border Grid.Column="4"
                        Background="#0A1F04"
                        BorderBrush="#2E5E1E"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="8,4">
                        <TextBlock Text="{Binding StatusText}"
                               Foreground="White"
                               FontSize="13"
                               TextWrapping="Wrap"
                               VerticalAlignment="Center"/>
                    </Border>
                </Grid>

                <!-- Row 1: Computer Area -->
                <StackPanel Grid.Row="1"
                        HorizontalAlignment="Center"
                        Margin="0,20,0,10">
                    <TextBlock Text="Computer Player"
                           Foreground="White"
                           FontSize="16"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,8"/>
                    <ItemsControl ItemsSource="{Binding ComputerHand}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Image Source="{Binding BackImage}" Width="60"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="{Binding OpponentCardCountText}"
                           Foreground="White"
                           FontSize="14"
                           HorizontalAlignment="Center"
                           Margin="0,8,0,0"/>
                </StackPanel>

                <!-- Row 2: Deck and Pile -->
                <StackPanel Grid.Row="2"
                        HorizontalAlignment="Left"
                        Margin="250,0,0,0"
                        VerticalAlignment="Center">
                    <TextBlock Text="Deck"
                           Foreground="White"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,5"/>
                    <Image Source="/Images/card_back.png"
                       Width="100"
                       Height="150"/>
                    <TextBlock Text="{Binding DeckCountText}"
                           Foreground="White"
                           HorizontalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Row="2"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                    <TextBlock Text="Discard Pile"
                           Foreground="White"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,5"/>
                    <Image Source="{Binding Pile.TopCard.FaceImage}"
                       Width="100"
                       Height="150"/>
                </StackPanel>

            </Grid>
        </DockPanel>

        <!-- Main Menu Screen -->
        <Grid x:Name="MainMenuScreen"
              Panel.ZIndex="10"
              Visibility="Visible">
              <Grid.Background>
                  <!-- Reference: Image was created using Microsoft Copilot -->
                  <ImageBrush ImageSource="/Images/game_background.png"
                      Stretch="UniformToFill"/>
              </Grid.Background>

            <StackPanel HorizontalAlignment="Center"
                VerticalAlignment="Center">

                <TextBlock Text="CRAZY 8'S"
                   FontSize="60"
                   FontWeight="Bold"
                   Foreground="White"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,50"/>

                <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    Margin="0,0,0,20">
                    <TextBlock Text="Player Name:"
                       Foreground="White"
                       FontSize="16"
                       FontWeight="Bold"
                       VerticalAlignment="Center"
                       Margin="0,0,10,0"/>
                    <TextBox x:Name="PlayerNameInput"
                     Width="200"
                     Height="35"
                     FontSize="14"
                     Padding="6,4"
                     Background="#646B64"
                     Foreground="White"
                     BorderBrush="Blue"
                     CaretBrush="White"/>
                </StackPanel>

                <Button Content="New Game"
                Width="200" Height="45"
                Margin="0,0,0,15"
                Background="#3D403D"
                Foreground="Green"
                BorderBrush="Green"
                FontSize="16"
                ToolTip="Start new game (Enter)"
                Click="StartGameClick"/>

                <Button Content="Exit"
                Width="200" Height="45"
                Background="#3D403D"
                Foreground="Red"
                BorderBrush="Red"
                FontSize="16"
                ToolTip="Exit the application (Esc)"
                Click="exitClick"/>

            </StackPanel>
        </Grid>

        <!-- Dark Background -->
        <Grid x:Name="DarkBackground"
            Background="#E6000000"
            Visibility="Collapsed"
            Panel.ZIndex="1"/>

        <!-- Settings Screen -->
        <Grid x:Name="SettingsScreen"
              Visibility="Collapsed"
              Panel.ZIndex="2">

            <Border Width="700"
                    Height="500"
                    Background="#DD2D2D2D"
                    CornerRadius="15"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Padding="25"
                    BorderBrush="White"
                    BorderThickness="1">

                <StackPanel HorizontalAlignment="Center">

                    <!-- Title -->
                    <TextBlock Text="Settings"
                               FontSize="30"
                               FontWeight="Bold"
                               Foreground="White"
                               Margin="0,0,0,20"
                               HorizontalAlignment="Center"/>

                    <!-- Background Color -->
                    <TextBlock Text="Background Color"
                               FontWeight="Bold"
                               Foreground="White"
                               Margin="0,0,0,5"/>

                    <ComboBox x:Name="BackgroundColorPicker"
                              Width="300"
                              Height="35"
                              Margin="0,0,0,20">

                        <!-- Default -->
                        <ComboBoxItem Tag="#0E2B06">
                            <StackPanel Orientation="Horizontal">
                                <Rectangle Width="18" Height="18" Fill="#0E2B06" Margin="0,0,8,0"/>
                                <TextBlock Text="#0E2B06 (Default)" VerticalAlignment="Center"/>
                            </StackPanel>
                        </ComboBoxItem>

                        <!-- Red -->
                        <ComboBoxItem Tag="#FF0000">
                            <StackPanel Orientation="Horizontal">
                                <Rectangle Width="18" Height="18" Fill="#FF0000" Margin="0,0,8,0"/>
                                <TextBlock Text="#FF0000 (Red)" VerticalAlignment="Center"/>
                            </StackPanel>
                        </ComboBoxItem>

                        <!-- Orange -->
                        <ComboBoxItem Tag="#FF7F00">
                            <StackPanel Orientation="Horizontal">
                                <Rectangle Width="18" Height="18" Fill="#FF7F00" Margin="0,0,8,0"/>
                                <TextBlock Text="#FF7F00 (Orange)" VerticalAlignment="Center"/>
                            </StackPanel>
                        </ComboBoxItem>

                        <!-- Yellow -->
                        <ComboBoxItem Tag="#FFFF00">
                            <StackPanel Orientation="Horizontal">
                                <Rectangle Width="18" Height="18" Fill="#FFFF00" Margin="0,0,8,0"/>
                                <TextBlock Text="#FFFF00 (Yellow)" VerticalAlignment="Center"/>
                            </StackPanel>
                        </ComboBoxItem>

                        <!-- Green -->
                        <ComboBoxItem Tag="#00FF00">
                            <StackPanel Orientation="Horizontal">
                                <Rectangle Width="18" Height="18" Fill="#00FF00" Margin="0,0,8,0"/>
                                <TextBlock Text="#00FF00 (Green)" VerticalAlignment="Center"/>
                            </StackPanel>
                        </ComboBoxItem>

                        <!-- Blue -->
                        <ComboBoxItem Tag="#0000FF">
                            <StackPanel Orientation="Horizontal">
                                <Rectangle Width="18" Height="18" Fill="#0000FF" Margin="0,0,8,0"/>
                                <TextBlock Text="#0000FF (Blue)" VerticalAlignment="Center"/>
                            </StackPanel>
                        </ComboBoxItem>

                        <!-- Indigo -->
                        <ComboBoxItem Tag="#4B0082">
                            <StackPanel Orientation="Horizontal">
                                <Rectangle Width="18" Height="18" Fill="#4B0082" Margin="0,0,8,0"/>
                                <TextBlock Text="#4B0082 (Indigo)" VerticalAlignment="Center"/>
                            </StackPanel>
                        </ComboBoxItem>

                        <!-- Violet -->
                        <ComboBoxItem Tag="#8F00FF">
                            <StackPanel Orientation="Horizontal">
                                <Rectangle Width="18" Height="18" Fill="#8F00FF" Margin="0,0,8,0"/>
                                <TextBlock Text="#8F00FF (Violet)" VerticalAlignment="Center"/>
                            </StackPanel>
                        </ComboBoxItem>

                    </ComboBox>

                    <!-- Menu Color -->
                    <TextBlock Text="Menu Color"
                               FontWeight="Bold"
                               Foreground="White"
                               Margin="0,0,0,5"/>

                    <ComboBox x:Name="MenuColorPicker"
                              Width="300"
                              Height="35"
                              Margin="0,0,0,25">

                        <!-- Default -->
                        <ComboBoxItem Tag="#06193B">
                            <StackPanel Orientation="Horizontal">
                                <Rectangle Width="18" Height="18" Fill="#06193B" Margin="0,0,8,0"/>
                                <TextBlock Text="#06193B (Default)" VerticalAlignment="Center"/>
                            </StackPanel>
                        </ComboBoxItem>

                        <!-- Red -->
                        <ComboBoxItem Tag="#FF0000">
                            <StackPanel Orientation="Horizontal">
                                <Rectangle Width="18" Height="18" Fill="#FF0000" Margin="0,0,8,0"/>
                                <TextBlock Text="#FF0000 (Red)" VerticalAlignment="Center"/>
                            </StackPanel>
                        </ComboBoxItem>

                        <!-- Orange -->
                        <ComboBoxItem Tag="#FF7F00">
                            <StackPanel Orientation="Horizontal">
                                <Rectangle Width="18" Height="18" Fill="#FF7F00" Margin="0,0,8,0"/>
                                <TextBlock Text="#FF7F00 (Orange)" VerticalAlignment="Center"/>
                            </StackPanel>
                        </ComboBoxItem>

                        <!-- Yellow -->
                        <ComboBoxItem Tag="#FFFF00">
                            <StackPanel Orientation="Horizontal">
                                <Rectangle Width="18" Height="18" Fill="#FFFF00" Margin="0,0,8,0"/>
                                <TextBlock Text="#FFFF00 (Yellow)" VerticalAlignment="Center"/>
                            </StackPanel>
                        </ComboBoxItem>

                        <!-- Green -->
                        <ComboBoxItem Tag="#00FF00">
                            <StackPanel Orientation="Horizontal">
                                <Rectangle Width="18" Height="18" Fill="#00FF00" Margin="0,0,8,0"/>
                                <TextBlock Text="#00FF00 (Green)" VerticalAlignment="Center"/>
                            </StackPanel>
                        </ComboBoxItem>

                        <!-- Blue -->
                        <ComboBoxItem Tag="#0000FF">
                            <StackPanel Orientation="Horizontal">
                                <Rectangle Width="18" Height="18" Fill="#0000FF" Margin="0,0,8,0"/>
                                <TextBlock Text="#0000FF (Blue)" VerticalAlignment="Center"/>
                            </StackPanel>
                        </ComboBoxItem>

                        <!-- Indigo -->
                        <ComboBoxItem Tag="#4B0082">
                            <StackPanel Orientation="Horizontal">
                                <Rectangle Width="18" Height="18" Fill="#4B0082" Margin="0,0,8,0"/>
                                <TextBlock Text="#4B0082 (Indigo)" VerticalAlignment="Center"/>
                            </StackPanel>
                        </ComboBoxItem>

                        <!-- Violet -->
                        <ComboBoxItem Tag="#8F00FF">
                            <StackPanel Orientation="Horizontal">
                                <Rectangle Width="18" Height="18" Fill="#8F00FF" Margin="0,0,8,0"/>
                                <TextBlock Text="#8F00FF (Violet)" VerticalAlignment="Center"/>
                            </StackPanel>
                        </ComboBoxItem>

                    </ComboBox>

                    <!-- Buttons -->
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Center">

                        <Button Content="Save"
                                Width="120"
                                Margin="10,0"
                                ToolTip="Save and apply selected settings"
                                Click="SaveSettingsClick"/>

                        <Button Content="Exit"
                                Width="120"
                                Margin="10,0"
                                ToolTip="Exit from the setting"
                                Click="ExitSettingsClick"/>
                    </StackPanel>

                </StackPanel>
            </Border>
        </Grid>

        <!-- Rules Screen -->
        <Grid x:Name="RulesScreen"
              Visibility="Collapsed"
              Panel.ZIndex="2">

            <Border Width="900"
                    Height="500"
                    Background="#DD2D2D2D"
                    CornerRadius="15"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Padding="20"
                    BorderBrush="White"
                    BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Title -->
                    <TextBlock Grid.Row="0"
                               Grid.Column="0"
                               Grid.ColumnSpan="3"
                               Text="Game Guide"
                               FontSize="32"
                               FontWeight="Bold"
                               Margin="0,0,0,15"
                               Foreground="White"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"/>
                    <!-- Left Side: Rules -->
                    <Border Grid.Row="1"
                            Grid.Column="0"
                            Background="#402D2D2D"
                            CornerRadius="12"
                            Padding="15"
                            BorderBrush="White"
                            BorderThickness="1"
                            Margin="0,0,10,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0"
                                       Text="Game Rules"
                                       FontSize="20"
                                       FontWeight="Bold"
                                       Foreground="White"
                                       Margin="0,0,0,10"
                                       HorizontalAlignment="Center"/>

                            <ScrollViewer Grid.Row="1"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Auto">
                                <TextBlock TextWrapping="Wrap"
                                           Foreground="White"
                                           FontSize="14"
                                           LineHeight="22">
                                    
    
                                    1. The goal of Crazy 8's is to be the first player to get rid of all your cards.<LineBreak/>
                                    
                                    2. Players take turns playing one card at a time.<LineBreak/>
                                    
                                    3. You must match either the suit or the rank of the top card on the discard pile.<LineBreak/>
                                    
                                    4. If you cannot play a card, you must draw a card from the deck.<LineBreak/>
                                    
                                    5. Eights are wild cards. When you play an Eight, you can choose any suit.<LineBreak/>
                                    
                                    6. The first player with no cards left wins the round.

                                </TextBlock>
                            </ScrollViewer>

                        </Grid>          

                    </Border>

                    <!-- Right Side: Buttons/Features -->
                    <Border Grid.Row="1"
                            Grid.Column="2"
                            Background="#402D2D2D"
                            CornerRadius="12"
                            Padding="15"
                            BorderBrush="White"
                            BorderThickness="1"
                            Margin="10,0,0,0">

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0"
                                       Text="Controls and Features"
                                       FontSize="20"
                                       FontWeight="Bold"
                                       Foreground="White"
                                       Margin="0,0,0,10"
                                       HorizontalAlignment="Center"/>
                            <ScrollViewer Grid.Row="1"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">

                                <TextBlock TextWrapping="Wrap"
                                           Foreground="White"
                                           FontSize="14"
                                           LineHeight="22">
                                    

                                    • Draw Button: Draws one card from the deck when you cannot play.<LineBreak/>

                                    • Play Button: Plays the selected card if it is a valid move.<LineBreak/>

                                    • Reset Button: Starts a new game and resets the current round.<LineBreak/>

                                    • Settings Button: Opens the settings menu and lets the player change colours.<LineBreak/>

                                    • Exit Button: Returns to the main menu or exits the application.<LineBreak/>

                                    • Card Selection: Click a card in your hand first, then press Play.<LineBreak/>

                                    • Hotkeys:<LineBreak/>
                                    F1 = Guide<LineBreak/>
                                    Ctrl + D = Draw<LineBreak/>
                                    Ctrl + P = Play<LineBreak/>
                                    Ctrl + R = Reset<LineBreak/>
                                    Ctrl + S = Settings<LineBreak/>
                                    Esc = Exit / Back

                                </TextBlock>

                            </ScrollViewer>

                        </Grid>

                    </Border>
                    
                    <!-- Close Button -->
                    <Button Grid.Row="2"
                            Grid.ColumnSpan="3"
                            Content="Close"
                            Width="140"
                            Height="40"
                            Margin="0,20,0,0"
                            HorizontalAlignment="Center"
                            Background="#06193B"
                            Foreground="White"
                            BorderBrush="#6666BB"
                            ToolTip="Exit from the guide"
                            Click="CloseRulesClick"/>

                </Grid>
            </Border>
        </Grid>


        <!-- Suit Selection Screen -->
        <StackPanel x:Name="SuitScreen"
                    Visibility="Collapsed"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Panel.ZIndex="2">

            <TextBlock Text="You played an Eight! Choose a suit:"
                       FontSize="20"
                       FontWeight="Bold"
                       Foreground="White"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,20"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Content="Hearts"
                Width="100" Height="40" Margin="10"
                Background="#06193B" Foreground="White"
                BorderBrush="#6666BB"
                ToolTip="Choose Hearts as the new suit"
                Click="SuitHearts"/>
                <Button Content="Diamonds"
                Width="100" Height="40" Margin="10"
                Background="#06193B" Foreground="White"
                BorderBrush="#6666BB"
                ToolTip="Choose Diamonds as the new suit"
                Click="SuitDiamonds"/>
                <Button Content="Clubs"
                Width="100" Height="40" Margin="10"
                Background="#06193B" Foreground="White"
                BorderBrush="#6666BB"
                ToolTip="Choose Clubs as the new suit"
                Click="SuitClubs"/>
                <Button Content="Spades"
                Width="100" Height="40" Margin="10"
                Background="#06193B" Foreground="White"
                BorderBrush="#6666BB"
                ToolTip="Choose Spades as the new suit"
                Click="SuitSpades"/>
            </StackPanel>

        </StackPanel>

        <!-- Winner Screen -->
        <StackPanel x:Name="WinnerScreen"
            Visibility="Collapsed"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Panel.ZIndex="2">

            <TextBlock x:Name="WinnerText"
               FontSize="28"
               FontWeight="Bold"
               Foreground="White"
               HorizontalAlignment="Center"
               Margin="0,0,0,10"/>

            <TextBlock x:Name="WinnerSubText"
               FontSize="18"
               Foreground="White"
               HorizontalAlignment="Center"
               Margin="0,0,0,30"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Content="Play Again"
                Width="120" Height="40" Margin="10"
                Background="#06193B" Foreground="White"
                BorderBrush="#6666BB"
                ToolTip="Start a new game"
                Click="WinnerResetClick"/>
                <Button Content="Exit"
                Width="120" Height="40" Margin="10"
                Background="#06193B" Foreground="White"
                BorderBrush="#6666BB"
                ToolTip="Exit the application"
                Click="WinnerExitClick"/>
            </StackPanel>

        </StackPanel>

    </Grid>
</Window>
